{
  "model": "local/qwen",
  "update": "disable",
  "share": "disabled",
  "providers": {
    "local": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen": {
          "modelID": "Qwen3.5-9B-6bit",
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 98304,
            "output": 8192
          },
          "body": {
            "max_tokens": 8192,
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": true
            },
            "thinking_budget": 3072
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "temperature": 0.7,
                "top_p": 0.8,
                "presence_penalty": 1.5,
                "chat_template_kwargs": {
                  "enable_thinking": false
                },
                "thinking_budget": 0
              },
              "settings": {
                "baseURL": "http://127.0.0.1:8000/v1"
              }
            }
          ],
          "settings": {
            "baseURL": "http://127.0.0.1:8000/v1"
          },
          "package": "@opencode/ai/providers/openai-compatible",
          "name": "Qwen3.5-9B-6bit"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 4096,
    "keep": {
      "tokens": 4096
    }
  },
  "tool_output": {
    "max_bytes": 4096,
    "max_lines": 200
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "search_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "browser_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "browser_browser_snapshot",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "browser_browser_find",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "browser_browser_take_screenshot",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "browser_browser_run_code_unsafe",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "peekaboo_*",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "default_agent": "agent",
  "websearch": false,
  "snapshots": true,
  "mcp": {
    "servers": {
      "search": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "oauth": false,
        "codemode": false
      },
      "browser": {
        "type": "local",
        "command": [
          "__NODE__",
          "__ROOT__/browser/node_modules/@playwright/mcp/cli.js",
          "--browser",
          "chrome",
          "--isolated",
          "--caps",
          "vision,pdf",
          "--no-webmcp",
          "--image-responses",
          "allow",
          "--output-dir",
          "__ROOT__/browser-output",
          "--file-paths",
          "absolute"
        ],
        "codemode": false
      }
    }
  },
  "agents": {
    "build": {
      "hidden": true,
      "model": "local/qwen",
      "permissions": [
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "general",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "reviewer",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "browse",
          "effect": "allow"
        },
        {
          "action": "search_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "__ROOT__/browser-output/*",
          "effect": "allow"
        }
      ]
    },
    "agent": {
      "mode": "primary",
      "description": "Implement and verify changes in the current project",
      "permissions": [
        { "action": "subagent", "resource": "explore", "effect": "allow" },
        { "action": "subagent", "resource": "general", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "browse", "effect": "allow" },
        { "action": "search_*", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "__ROOT__/browser-output/*", "effect": "allow" }
      ]
    },
    "ask": {
      "mode": "primary",
      "description": "Investigate and answer without changing project files",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "deny" },
        { "action": "browser_*", "resource": "*", "effect": "deny" },
        { "action": "peekaboo_*", "resource": "*", "effect": "deny" }
      ]
    },
    "plan": {
      "description": "Research sources and plan changes without editing the project",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "peekaboo_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explore": {
      "permissions": [
        {
          "action": "browser_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "peekaboo_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "search_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "general": {
      "mode": "subagent",
      "description": "Complete one bounded coding or investigation subtask",
      "steps": 16,
      "permissions": [
        {
          "action": "browser_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "peekaboo_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "description": "Read-only review for correctness and regressions",
      "system": "Review the supplied work for correctness, regressions and missing tests. Give each actionable finding a current project-relative path:line citation. Treat source citations as locations, not proof of the claimed defect. Do not edit files. Distinguish tests actually run from suggested tests; report unsupported claims as unverified.",
      "permissions": [
        {
          "action": "browser_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "peekaboo_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "search_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "model": "local/qwen#fast"
    },
    "browse": {
      "mode": "subagent",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser_browser_navigate",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_navigate_back",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_snapshot",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "browser_browser_click",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_type",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_fill_form",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_press_key",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_select_option",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_wait_for",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_take_screenshot",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "browser_browser_console_messages",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "browser_browser_network_requests",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "browser_browser_resize",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_tabs",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_handle_dialog",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_file_upload",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "browser_browser_close",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "__ROOT__/xdg/data/opencode/tool-output/tool_*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "__ROOT__/xdg/data/opencode/tool-output/*",
          "effect": "allow"
        }
      ],
      "description": "Inspect and test rendered interfaces in the isolated browser; report observed flows, console errors and screenshots"
    },
    "audit": {
      "hidden": true,
      "mode": "primary",
      "description": "Read-only audit with one fresh Reviewer",
      "model": "local/qwen",
      "system": "Coordinate a read-only audit. Inspect relevant files and available diff/check evidence, then delegate exactly once to a fresh Reviewer with no sessionID, model override, or background execution. Supply acceptance criteria, changed paths and actual evidence. Wait for the Reviewer, then check each finding against current source before reporting; citation existence alone does not prove correctness. Do not claim tests ran unless their results are available. You remain read-only until the user explicitly switches agents.",
      "permissions": [
        {
          "action": "browser_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "peekaboo_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "search_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "reviewer",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "__ROOT__/xdg/data/opencode/tool-output/tool_*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "__ROOT__/xdg/data/opencode/tool-output/*",
          "effect": "allow"
        }
      ]
    }
  },
  "commands": {
    "call": {
      "agent": "general",
      "subagent": true,
      "description": "Run a coding-capable child, even from Ask or Plan",
      "template": "Complete only this subtask in the current project: $ARGUMENTS. Inspect relevant files first, make the smallest needed change, and run an appropriate check. Do not start another child, publish, release, or push. Return changed paths, exact check commands and results, and anything unfinished."
    },
    "review": {
      "agent": "reviewer",
      "subagent": true,
      "template": "Review current changes for correctness, regressions and missing tests. Report actionable findings with file and line references. Do not edit files. $ARGUMENTS"
    },
    "handoff": {
      "agent": "agent",
      "subagent": false,
      "template": "Return a concise handoff with objective, acceptance checks, completed work, actual check commands/results, unresolved failures, disproven approaches, and the next action. Reconcile with current Git and files. Use the native checkpoint; do not overwrite user-owned task files. $ARGUMENTS"
    },
    "audit": {
      "agent": "reviewer",
      "subagent": true,
      "template": "Audit $ARGUMENTS without modifying files. Inspect relevant files, diff and available check evidence. Report actionable findings with file and line references, and say what was not checked. Do not fix findings or claim checks ran unless their results are available."
    }
  },
  "plugins": [
    "opencode.config.policy",
    "-opencode.config.compatibility",
    "-opencode.browser",
    {
      "package": "__KRYN_PLUGIN__",
      "options": {
        "stateDir": "__KRYN_STATE__",
        "nodeBinary": "__NODE__",
        "profileId": "__PROFILE_ID__",
        "modelID": "Qwen3.5-9B-6bit",
        "champion": {
          "revision": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
          "instructions": ""
        },
        "observe": true,
        "workflowScope": null
      }
    }
  ],
  "experimental": {
    "policies": []
  },
  "skills": [
    ".agents/skills",
    ".claude/skills"
  ]
}
