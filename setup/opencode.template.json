{
  "model": "local/qwen#think",
  "update": "disable",
  "share": "disabled",
  "providers": {
    "local": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen": {
          "modelID": "Qwen3.5-9B-6bit",
          "compatibility": {
            "reasoningField": "reasoning_content",
            "maxTokensField": "max_tokens"
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 24576,
            "output": 8192
          },
          "body": {
            "max_tokens": 8192,
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
          "variants": [
            {
              "id": "think",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                }
              },
              "settings": {
                "baseURL": "http://127.0.0.1:8000/v1"
              }
            },
            {
              "id": "fast",
              "body": {
                "temperature": 0.7,
                "top_p": 0.8,
                "presence_penalty": 1.5,
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              },
              "settings": {
                "baseURL": "http://127.0.0.1:8000/v1"
              }
            }
          ],
          "settings": {
            "baseURL": "http://127.0.0.1:8000/v1"
          },
          "package": "@opencode/ai/providers/openai-compatible",
          "name": "Qwen3.5-9B-6bit"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 4096,
    "keep": {
      "tokens": 4096
    }
  },
  "tool_output": {
    "max_bytes": 4096,
    "max_lines": 200
  },
  "permissions": [
    {
