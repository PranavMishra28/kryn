  "commands": {
    "research": {
      "agent": "plan",
      "model": "local/qwen#think",
      "subagent": false,
      "template": "Research $ARGUMENTS using keyless search and webfetch. Open primary sources, compare evidence and dates, cite URLs, and identify uncertainty. If search is rate limited, stop and explain; do not authenticate a paid provider."
    },
    "review": {
      "agent": "reviewer",
      "model": "local/qwen#think",
      "subagent": false,
      "template": "Review current changes for correctness, regressions and missing tests. Report actionable findings with file and line references. Do not edit files. $ARGUMENTS"
    },
    "deliver": {
      "agent": "build",
      "model": "local/qwen#think",
      "subagent": false,
      "template": "Deliver $ARGUMENTS. First state the smallest useful milestone and observable acceptance criteria. Inspect relevant code and tests, implement that milestone, run suitable checks, and inspect the real output or browser UI when relevant. Preserve user changes. After two repair cycles without new evidence, summarize the blocker and next hypothesis instead of repeating the same attempt. Use one foreground child at a time. Report actual results and unresolved risks; never weaken tests just to pass. This is a workflow instruction, not an enforced execution budget."
    },
    "handoff": {
      "agent": "build",
      "model": "local/qwen#think",
      "subagent": false,
      "template": "Return a concise handoff with objective, acceptance checks, completed work, actual check commands/results, unresolved failures, disproven approaches, and the next action. Reconcile with current Git and files. Use the native checkpoint; do not overwrite user-owned task files. $ARGUMENTS"
    },
    "audit": {
      "agent": "audit",
      "model": "local/qwen#think",
      "subagent": false,
      "template": "Audit $ARGUMENTS without modifying files. Inspect relevant files and available diff/check evidence. Launch exactly one new reviewer subagent with background:false, no sessionID and no model override. Supply acceptance criteria, changed paths, available raw diff and actual check results; identify missing evidence. Wait for its result, then report actionable findings with file and line references. Do not fix findings. Remain in Audit mode until the user explicitly switches agents."
    }
  },
