  "default_agent": "build",
  "websearch": false,
  "snapshots": true,
  "mcp": {
    "servers": {
      "search": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "oauth": false,
        "codemode": false
      },
      "browser": {
        "type": "local",
        "command": [
          "__NODE__",
          "__ROOT__/browser/node_modules/@playwright/mcp/cli.js",
          "--browser",
          "chrome",
          "--isolated",
          "--caps",
          "vision,pdf",
          "--no-webmcp",
          "--image-responses",
          "allow",
          "--output-dir",
          "__ROOT__/browser-output",
          "--file-paths",
          "absolute"
        ],
        "codemode": false
      }
    }
  },
